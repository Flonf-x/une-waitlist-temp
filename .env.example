# ── Backend waitlist temporaire — variables d'environnement ──
# Copie en .env pour un test local : cp .env.example .env

# Postgres managé (Neon recommandé — free tier persistant). Format :
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# SendGrid (déjà utilisé par le monorepo une.). Sans clé, le service tourne
# mais n'envoie pas d'email de confirmation.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=bonjour@une-app.fr

# URL PUBLIQUE de CE service (sert à fabriquer le lien de désinscription).
# Ex. https://une-waitlist-temp.onrender.com  ou  https://une-waitlist-temp.fly.dev
PUBLIC_BACKEND_URL=

# Origines autorisées en CORS (la landing). Séparées par des virgules.
ALLOWED_ORIGINS=https://une-app.fr,https://www.une-app.fr

# Clé d'accès à la page d'admin (vue interne des inscrits) servie sur
# GET /api/v1/waitlist/admin?key=<ADMIN_KEY>. Vide = page d'admin désactivée.
# Mets une longue chaîne aléatoire (≥ 32 caractères). Exemple de génération :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=

# Port (Render/Fly l'injectent automatiquement ; 3000 en local).
PORT=3000
